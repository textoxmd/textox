{
  "name": "texto",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "official-plugins/*",
    "test-fixtures/plugins/*",
    "plugin-samples/*",
    "packages/*"
  ],
  "version": "2.4.2",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/check/vite-cache.mjs && bun run i18n:build && vite",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/components/TextoEditor/tsconfig.json --noEmit && tsc -p packages/plugin-sdk/tsconfig.json --noEmit && tsc -p packages/markdown-editor-api/tsconfig.json --noEmit && tsc -p packages/app-api/tsconfig.json --noEmit && tsc -p packages/export-runtime/tsconfig.json --noEmit && tsc -p packages/ai-prompt/tsconfig.json --noEmit && tsc -p vendor/plugin-sdk/tsconfig.json --noEmit && tsc -p packages/plugin-build/tsconfig.json --noEmit && tsc -p packages/markdown-editor-runtime/tsconfig.json --noEmit && node scripts/check/typecheck-official-plugins.mjs",
    "test:plugins": "vitest run --config vitest.config.ts",
    "plugin": "bun run packages/plugin-build/src/cli.ts",
    "plugin:cli": "cargo run --manifest-path src-tauri/Cargo.toml --features plugin-cli --bin plugin-cli --",
    "check:skeleton": "node scripts/check/skeleton.mjs",
    "check:editor-boundary": "node scripts/check/editor-boundary.mjs",
    "check:version": "node scripts/check/versions.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "i18n:build": "bun run scripts/i18n/build.mjs",
    "prebuild": "bun run i18n:build",
    "app:dev": "bun run scripts/build/cli.mjs dev --edition full",
    "app:build": "bun run scripts/build/cli.mjs build --edition full",
    "app:package": "bun run scripts/build/cli.mjs package"
  },

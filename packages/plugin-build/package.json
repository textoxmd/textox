{
  "name": "@textox/plugin-build",
  "version": "0.1.7",
  "description": "Build tooling for Textox plugins (bundle + manifest + .zip packaging)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "bin": {
    "texto-plugin": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@textox/plugin-sdk": "^0.3.0",
    "fflate": "^0.8.2",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.1.2"
  }
}
